---
// A stylized, animated security console. It's illustrative — a signal of the
// kind of dense, high-stakes product UI this portfolio is about.
const alerts = [
  { sev: 'critical', title: 'Impossible travel → privileged sign-in', entity: 'j.ortiz@acme.co', tech: 'T1078', time: '12s' },
  { sev: 'high', title: 'Suspicious OAuth consent grant', entity: 'Mail.ReadWrite', tech: 'T1528', time: '48s' },
  { sev: 'medium', title: 'LSASS memory access by unsigned binary', entity: 'WS-FIN-0142', tech: 'T1003', time: '2m' },
  { sev: 'low', title: 'New admin added to cloud tenant', entity: 'aws:prod-core', tech: 'T1098', time: '6m' },
  { sev: 'medium', title: 'Encoded PowerShell via Office macro', entity: 'WS-OPS-0031', tech: 'T1059', time: '9m' },
];

const bars = [18, 24, 20, 32, 28, 36, 30, 44, 38, 52, 46, 40, 58, 50, 62, 48, 56, 70, 60, 54, 66, 58, 74, 64];
---

<div class="console-stage" aria-hidden="true">
  <div class="console glass">
    <div class="titlebar">
      <div class="lights"><span></span><span></span><span></span></div>
      <div class="crumbs mono"><span>sentinel</span><span class="sep">/</span><span>detections</span><span class="sep">/</span><span class="here">live</span></div>
      <div class="live mono"><span class="status-dot"></span> Streaming</div>
    </div>

    <div class="body">
      <aside class="rail">
        {
          ['M4 6h16M4 12h16M4 18h10', 'M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z', 'M3 12h4l3-8 4 16 3-8h4', 'M12 8v4l3 2M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z', 'M4 20V10M10 20V4M16 20v-7M22 20H2'].map((d, i) => (
            <span class:list={['rail-btn', { on: i === 1 }]}>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={d} /></svg>
            </span>
          ))
        }
      </aside>

      <div class="main">
        <div class="kpis">
          <div class="kpi">
            <span class="k-label">Open detections</span>
            <span class="k-value mono" data-count="128">128</span>
            <span class="k-delta down">↓ 23% wk</span>
          </div>
          <div class="kpi">
            <span class="k-label">Mean time to triage</span>
            <span class="k-value mono">4m 12s</span>
            <span class="k-delta down">↓ 61%</span>
          </div>
          <div class="kpi hide-sm">
            <span class="k-label">Auto-resolved</span>
            <span class="k-value mono">72%</span>
            <span class="k-delta up">↑ 18 pts</span>
          </div>
        </div>

        <div class="chart">
          <div class="chart-head">
            <span>Detection volume · 24h</span>
            <span class="legend mono"><i></i>signal <i class="noise"></i>noise</span>
          </div>
          <div class="bars">
            {bars.map((h, i) => <span style={`--h:${h}%; --d:${i * 30}ms`} class:list={{ hot: i === 17 }} />)}
          </div>
        </div>

        <div class="table">
          <div class="row head">
            <span>Severity</span><span>Detection</span><span class="hide-sm">Entity</span><span class="hide-md">ATT&amp;CK</span><span class="t-right">Age</span>
          </div>
          <div class="rows" id="alert-rows">
            {
              alerts.map((a, i) => (
                <div class:list={['row', { selected: i === 1 }]}>
                  <span class={`sev sev-${a.sev}`}>
                    <i />
                    {a.sev}
                  </span>
                  <span class="title">{a.title}</span>
                  <span class="entity mono hide-sm">{a.entity}</span>
                  <span class="tech mono hide-md">{a.tech}</span>
                  <span class="age mono t-right">{a.time}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Floating investigation panel -->
  <div class="panel glass">
    <div class="panel-head">
      <span class="chip chip-accent">AI summary</span>
      <span class="mono faint">INC-2291</span>
    </div>
    <p class="panel-title">Suspicious OAuth consent grant</p>
    <p class="panel-copy">
      Third-party app requested <b>Mail.ReadWrite</b> 3 min after a risky sign-in from a new ASN. Pattern matches 4 prior consent-phishing incidents.
    </p>
    <ol class="timeline">
      <li><span class="mono">09:41</span> Risky sign-in · new ASN</li>
      <li><span class="mono">09:44</span> Consent granted to “DocSign Pro”</li>
      <li class="now"><span class="mono">09:45</span> Inbox rule created</li>
    </ol>
    <div class="panel-actions">
      <span class="pa primary">Revoke &amp; contain</span>
      <span class="pa">Assign</span>
    </div>
  </div>
</div>

<script>
  // Cycle alerts: bring the bottom row to the top as if a new one streamed in.
  const rows = document.getElementById('alert-rows');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (rows && !reduce) {
    setInterval(() => {
      const last = rows.lastElementChild as HTMLElement | null;
      if (!last) return;
      last.classList.remove('selected', 'enter');
      const age = last.querySelector('.age');
      if (age) age.textContent = 'now';
      rows.prepend(last);
      void last.offsetWidth;
      last.classList.add('enter');
    }, 3200);
  }
</script>

<style>
  .console-stage {
    position: relative;
    perspective: 2000px;
    padding-bottom: 40px;
  }

  .console {
    border-radius: 16px;
    overflow: hidden;
    background: color-mix(in srgb, var(--bg-elev) 72%, transparent);
    transform: rotateX(8deg);
    transform-origin: 50% 0%;
    animation: tilt-in 1.4s var(--ease) 0.2s both;
    box-shadow:
      var(--glass-highlight),
      0 0 0 1px var(--border),
      0 40px 120px -30px rgb(0 0 0 / 0.7),
      0 0 120px -40px var(--accent-glow);
  }

  :global([data-theme='light']) .console {
    box-shadow:
      var(--glass-highlight),
      0 0 0 1px var(--border),
      0 40px 100px -30px rgb(0 0 0 / 0.18);
  }

  @keyframes tilt-in {
    from {
      opacity: 0;
      transform: rotateX(24deg) translateY(40px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: rotateX(8deg);
    }
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 40px;
    padding-inline: 14px;
    border-bottom: 1px solid var(--border);
    font-size: 12px;
    color: var(--fg-subtle);
  }
  .lights {
    display: flex;
    gap: 6px;
  }
  .lights span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .crumbs {
    display: flex;
    gap: 6px;
  }
  .crumbs .sep {
    color: var(--fg-faint);
  }
  .crumbs .here {
    color: var(--fg);
  }
  .live {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
  }

  .body {
    display: grid;
    grid-template-columns: 52px 1fr;
    min-height: 0;
  }
  .rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding-block: 14px;
    border-right: 1px solid var(--border);
  }
  .rail-btn {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    color: var(--fg-subtle);
  }
  .rail-btn.on {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .main {
    padding: 18px;
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .kpis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .kpi {
    display: grid;
    gap: 2px;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--glass);
  }
  .k-label {
    font-size: 11px;
    color: var(--fg-subtle);
  }
  .k-value {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  .k-delta {
    font-size: 11px;
  }
  .k-delta.down,
  .k-delta.up {
    color: var(--accent);
  }

  .chart {
    padding: 12px 14px 10px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--glass);
  }
  .chart-head {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--fg-subtle);
    margin-bottom: 10px;
  }
  .legend {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .legend i {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--accent);
  }
  .legend i.noise {
    margin-left: 6px;
    background: var(--border-strong);
  }
  .bars {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 64px;
  }
  .bars span {
    flex: 1;
    height: var(--h);
    border-radius: 3px 3px 1px 1px;
    background: linear-gradient(to top, var(--border-strong) 55%, color-mix(in srgb, var(--accent) 70%, transparent) 55%);
    transform-origin: bottom;
    animation: grow 0.9s var(--ease) calc(0.6s + var(--d)) both;
  }
  .bars span.hot {
    background: var(--accent);
    box-shadow: 0 0 16px var(--accent-glow);
  }
  @keyframes grow {
    from {
      transform: scaleY(0);
    }
  }

  .table {
    border-radius: 10px;
    border: 1px solid var(--border);
    overflow: hidden;
    font-size: 12.5px;
  }
  .row {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr) 130px 64px 44px;
    align-items: center;
    gap: 12px;
    height: 38px;
    padding-inline: 14px;
    border-top: 1px solid var(--border);
    color: var(--fg-muted);
  }
  .row.head {
    border-top: 0;
    height: 32px;
    font-size: 11px;
    color: var(--fg-subtle);
    background: var(--glass);
  }
  .row.selected {
    background: var(--accent-soft);
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .row.enter {
    animation: row-in 0.7s var(--ease);
  }
  @keyframes row-in {
    from {
      background: var(--accent-soft);
      opacity: 0;
      transform: translateY(-8px);
    }
    40% {
      opacity: 1;
      transform: none;
      background: var(--accent-soft);
    }
  }
  .title {
    color: var(--fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .entity,
  .tech,
  .age {
    font-size: 11.5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .t-right {
    text-align: right;
  }
  .sev {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-transform: capitalize;
    font-size: 11.5px;
  }
  .sev i {
    width: 7px;
    height: 7px;
    border-radius: 2px;
  }
  .sev-critical i {
    background: var(--sev-critical);
    box-shadow: 0 0 8px var(--sev-critical);
  }
  .sev-high i {
    background: var(--sev-high);
  }
  .sev-medium i {
    background: var(--sev-medium);
  }
  .sev-low i {
    background: var(--sev-low);
  }

  /* Floating panel */
  .panel {
    position: absolute;
    right: -28px;
    bottom: -8px;
    width: 300px;
    padding: 16px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--bg-elev) 55%, transparent);
    --glass-blur: 28px;
    animation: float-in 1.2s var(--ease) 1.1s both;
    font-size: 13px;
  }
  @keyframes float-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.97);
    }
  }
  .panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .faint {
    font-size: 11px;
    color: var(--fg-subtle);
  }
  .panel-title {
    margin-top: 12px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .panel-copy {
    margin-top: 6px;
    color: var(--fg-muted);
    font-size: 12.5px;
    line-height: 1.55;
  }
  .panel-copy b {
    color: var(--fg);
    font-weight: 500;
  }
  .timeline {
    list-style: none;
    margin: 14px 0 0;
    padding: 0 0 0 14px;
    border-left: 1px solid var(--border-strong);
    display: grid;
    gap: 8px;
    font-size: 12px;
    color: var(--fg-muted);
  }
  .timeline li {
    position: relative;
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: -18px;
    top: 7px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--bg-elev);
    border: 1px solid var(--fg-faint);
  }
  .timeline li.now::before {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 10px var(--accent);
  }
  .timeline .mono {
    color: var(--fg-subtle);
    margin-right: 6px;
  }
  .panel-actions {
    display: flex;
    gap: 8px;
    margin-top: 14px;
  }
  .pa {
    flex: 1;
    text-align: center;
    padding: 7px 10px;
    border-radius: 8px;
    border: 1px solid var(--border-strong);
    font-size: 12px;
    color: var(--fg);
  }
  .pa.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-fg);
    font-weight: 500;
  }

  @media (max-width: 1100px) {
    .panel {
      right: 16px;
    }
  }
  @media (max-width: 860px) {
    .hide-md {
      display: none;
    }
    .row {
      grid-template-columns: 84px minmax(0, 1fr) 120px 40px;
    }
    .panel {
      position: relative;
      right: auto;
      bottom: auto;
      width: auto;
      margin: -40px 16px 0;
    }
  }
  @media (max-width: 600px) {
    .hide-sm {
      display: none;
    }
    .body {
      grid-template-columns: 1fr;
    }
    .rail {
      display: none;
    }
    .kpis {
      grid-template-columns: 1fr 1fr;
    }
    .row {
      grid-template-columns: 76px minmax(0, 1fr) 36px;
      gap: 8px;
      padding-inline: 10px;
    }
    .main {
      padding: 12px;
    }
    .crumbs {
      display: none;
    }
    .console {
      transform: none;
      animation-name: fade-up;
    }
    @keyframes fade-up {
      from {
        opacity: 0;
        transform: translateY(24px);
      }
    }
  }
</style>
