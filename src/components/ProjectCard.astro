---
import type { CollectionEntry } from 'astro:content';
import ProjectVisual from './ProjectVisual.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  large?: boolean;
}
const { project, large = false } = Astro.props;
const { title, summary, company, year, tags, visual, outcomes } = project.data;
---

<a href={`/projects/${project.id}`} class:list={['card glass card-hover', { large }]}>
  <div class="media">
    <ProjectVisual variant={visual} />
  </div>
  <div class="content">
    <div class="meta mono">
      <span>{company}</span><span class="dot">·</span><span>{year}</span>
    </div>
    <h3>{title}</h3>
    <p class="muted">{summary}</p>
    {
      large && outcomes.length > 0 && (
        <div class="outcomes">
          {outcomes.slice(0, 3).map((o) => (
            <div>
              <span class="ov">{o.value}</span>
              <span class="ol">{o.label}</span>
            </div>
          ))}
        </div>
      )
    }
    <div class="foot">
      <div class="tags">{tags.slice(0, 3).map((t) => <span class="chip">{t}</span>)}</div>
      <span class="read">Read case study <span class="arrow">→</span></span>
    </div>
  </div>
</a>

<style>
  .card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    border-radius: var(--radius-lg);
  }
  .card.large {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
  }
  .media {
    border-bottom: 1px solid var(--border);
  }
  .large .media {
    border-bottom: 0;
    border-right: 1px solid var(--border);
  }
  .large .media :global(.pv) {
    height: 100%;
    min-height: 340px;
    aspect-ratio: auto;
  }
  .content {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
  }
  .large .content {
    padding: 36px;
    justify-content: center;
  }
  .meta {
    display: flex;
    gap: 8px;
    font-size: 12px;
    color: var(--fg-subtle);
  }
  .dot {
    color: var(--fg-faint);
  }
  h3 {
    font-size: 20px;
  }
  .large h3 {
    font-size: 28px;
    letter-spacing: -0.03em;
  }
  p {
    font-size: 15px;
  }
  .outcomes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 12px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }
  .outcomes div {
    display: grid;
    gap: 2px;
  }
  .ov {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .ol {
    font-size: 12px;
    color: var(--fg-subtle);
    line-height: 1.4;
  }
  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: auto;
    padding-top: 14px;
    flex-wrap: wrap;
  }
  .tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .read {
    font-size: 13px;
    color: var(--fg-muted);
    display: inline-flex;
    gap: 6px;
    transition: color 0.2s var(--ease);
  }
  .card:hover .read {
    color: var(--accent);
  }
  .arrow {
    transition: transform 0.2s var(--ease);
  }
  .card:hover .arrow {
    transform: translateX(3px);
  }
  @media (max-width: 860px) {
    .card.large {
      grid-template-columns: 1fr;
    }
    .large .media :global(.pv) {
      min-height: 0;
      aspect-ratio: 16 / 10;
    }
    .large .media {
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
    .large .content {
      padding: 24px;
    }
  }
</style>
