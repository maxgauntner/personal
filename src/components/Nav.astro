---
import { NAV, SITE } from '../site';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="nav-wrap">
  <nav class="nav glass container-ish" aria-label="Primary">
    <a href="/" class="brand" aria-label={`${SITE.name} — home`}>
      <span class="mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="22" height="22"
          ><path
            d="M9 22V10l7 7 7-7v12"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
      </span>
      <span class="brand-name">{SITE.name}</span>
    </a>

    <ul class="links">
      {
        NAV.map((item) => (
          <li>
            <a href={item.href} class:list={{ active: isActive(item.href) }} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="actions">
      <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle color theme">
        <svg class="sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
          ><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg
        >
        <svg class="moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
          ><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg
        >
      </button>
      <a href={`mailto:${SITE.email}`} class="btn btn-primary contact">Contact</a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .nav-wrap {
    position: sticky;
    top: 12px;
    z-index: 50;
    padding-inline: var(--gutter);
    margin-top: 12px;
  }
  .nav {
    max-width: var(--container);
    margin-inline: auto;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 8px 0 14px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 65%, transparent);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.02em;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    color: var(--accent);
    background: var(--glass-strong);
    border: 1px solid var(--border);
  }
  .links {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a {
    display: block;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 14px;
    color: var(--fg-muted);
    transition: color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .links a:hover {
    color: var(--fg);
  }
  .links a.active {
    color: var(--fg);
    background: var(--glass-strong);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 0;
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
  }
  .icon-btn:hover {
    color: var(--fg);
    background: var(--glass-strong);
  }
  :global([data-theme='light']) .sun,
  :global([data-theme='dark']) .moon {
    display: none;
  }
  .contact {
    height: 36px;
    padding-inline: 14px;
  }
  @media (max-width: 640px) {
    .brand-name,
    .contact {
      display: none;
    }
    .links a {
      padding: 6px 10px;
    }
  }
</style>
