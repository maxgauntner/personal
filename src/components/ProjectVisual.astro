---
// Abstract, on-brand cover art for case studies. Replace with real
// screenshots (src/assets) once you have NDA-safe imagery.
interface Props {
  variant: 'detections' | 'identity' | 'incident' | 'vuln';
  size?: 'card' | 'hero';
}
const { variant, size = 'card' } = Astro.props;
---

<div class:list={['pv', `pv-${variant}`, `pv-${size}`]} aria-hidden="true">
  <div class="pv-glow"></div>
  <div class="pv-grid"></div>

  {
    variant === 'detections' && (
      <div class="win glass">
        <div class="bar"><i /><i /><i /></div>
        <div class="list">
          {['c', 'h', 'm', 'm', 'l'].map((s, i) => (
            <div class:list={['li', { on: i === 1 }]}>
              <b class={`s-${s}`} />
              <span style={`width:${[72, 58, 80, 46, 64][i]}%`} />
            </div>
          ))}
        </div>
      </div>
    )
  }

  {
    variant === 'identity' && (
      <div class="graph">
        <svg viewBox="0 0 320 180" fill="none">
          <g stroke="currentColor" stroke-opacity="0.25">
            <path d="M160 90 L70 46 M160 90 L70 134 M160 90 L250 40 M160 90 L256 100 M160 90 L232 150 M250 40 L256 100" />
          </g>
          <path d="M160 90 L250 40" stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="3 4" />
          <circle cx="160" cy="90" r="18" fill="var(--accent-soft)" stroke="var(--accent)" />
          {[[70, 46], [70, 134], [256, 100], [232, 150]].map(([x, y]) => (
            <circle cx={x} cy={y} r="9" fill="var(--bg-elev)" stroke="currentColor" stroke-opacity="0.35" />
          ))}
          <circle cx="250" cy="40" r="11" fill="var(--bg-elev)" stroke="var(--sev-high)" />
        </svg>
        <div class="tag glass mono">admin:* · unused 94d</div>
      </div>
    )
  }

  {
    variant === 'incident' && (
      <div class="win glass">
        <div class="bar"><i /><i /><i /></div>
        <div class="tl">
          {[0, 1, 2, 3].map((i) => (
            <div class:list={['step', { done: i < 2, now: i === 2 }]}>
              <b />
              <span style={`width:${[60, 74, 52, 66][i]}%`} />
            </div>
          ))}
        </div>
      </div>
    )
  }

  {
    variant === 'vuln' && (
      <div class="win glass">
        <div class="bar"><i /><i /><i /></div>
        <div class="heat">
          {Array.from({ length: 48 }).map((_, i) => {
            const v = (i * 37) % 11;
            return <span class={v > 8 ? 'h3' : v > 5 ? 'h2' : v > 2 ? 'h1' : ''} />;
          })}
        </div>
      </div>
    )
  }
</div>

<style>
  .pv {
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    background: var(--bg-sunken);
    color: var(--fg);
    isolation: isolate;
  }
  .pv-hero {
    aspect-ratio: 16 / 8;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
  }
  .pv-glow {
    position: absolute;
    width: 70%;
    height: 70%;
    left: 15%;
    top: 30%;
    border-radius: 50%;
    background: var(--accent-glow);
    filter: blur(60px);
    z-index: -1;
  }
  .pv-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--border-strong) 1px, transparent 1px);
    background-size: 16px 16px;
    -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
    mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
    z-index: -1;
  }
  .win {
    width: 68%;
    border-radius: 12px;
    padding: 0 0 12px;
    background: color-mix(in srgb, var(--bg-elev) 70%, transparent);
    transition: transform 0.5s var(--ease);
  }
  :global(.card-hover:hover) .win {
    transform: translateY(-4px) scale(1.02);
  }
  .bar {
    display: flex;
    gap: 5px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 10px;
  }
  .bar i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .list,
  .tl {
    display: grid;
    gap: 7px;
    padding-inline: 12px;
  }
  .li,
  .step {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 20px;
    padding-inline: 6px;
    border-radius: 6px;
  }
  .li.on {
    background: var(--accent-soft);
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .li b {
    width: 6px;
    height: 6px;
    border-radius: 2px;
  }
  .li span,
  .step span {
    height: 5px;
    border-radius: 3px;
    background: var(--border-strong);
  }
  .s-c {
    background: var(--sev-critical);
  }
  .s-h {
    background: var(--sev-high);
  }
  .s-m {
    background: var(--sev-medium);
  }
  .s-l {
    background: var(--sev-low);
  }
  .step b {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1px solid var(--fg-faint);
    flex: none;
  }
  .step.done b {
    background: var(--fg-subtle);
    border-color: var(--fg-subtle);
  }
  .step.now b {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }
  .step.now span {
    background: color-mix(in srgb, var(--accent) 50%, transparent);
  }
  .graph {
    position: relative;
    width: 80%;
  }
  .graph svg {
    width: 100%;
  }
  .tag {
    position: absolute;
    right: 0;
    top: -4px;
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 10px;
    color: var(--fg-muted);
  }
  .heat {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 4px;
    padding-inline: 12px;
  }
  .heat span {
    aspect-ratio: 1;
    border-radius: 3px;
    background: var(--glass-strong);
  }
  .heat .h1 {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
  }
  .heat .h2 {
    background: color-mix(in srgb, var(--accent) 50%, transparent);
  }
  .heat .h3 {
    background: var(--accent);
  }
</style>
