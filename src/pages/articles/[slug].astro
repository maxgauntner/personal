---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getArticles, readingTime } from '../../utils';
import { SITE } from '../../site';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const d = article.data;
---

<Base title={d.title} description={d.description}>
  <article class="container art">
    <header>
      <a href="/articles" class="link-arrow">← All writing</a>
      <div class="meta mono">
        <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
        <span>·</span>
        <span>{readingTime(article.body)}</span>
      </div>
      <h1 class="text-gradient">{d.title}</h1>
      <p class="lead">{d.description}</p>
      <div class="tags">{d.tags.map((t) => <span class="chip">{t}</span>)}</div>
    </header>
    <div class="prose"><Content /></div>
    <footer class="author glass">
      <div>
        <strong>{SITE.name}</strong>
        <p class="muted">{SITE.role} focused on cybersecurity SaaS.</p>
      </div>
      <a href={`mailto:${SITE.email}`} class="btn btn-ghost">Say hello</a>
    </footer>
  </article>
</Base>

<style>
  .art {
    max-width: calc(720px + var(--gutter) * 2);
    padding-block: clamp(48px, 8vw, 96px) clamp(72px, 10vw, 128px);
  }
  header {
    display: grid;
    gap: 16px;
    padding-bottom: 40px;
    margin-bottom: 40px;
    border-bottom: 1px solid var(--border);
  }
  .meta {
    display: flex;
    gap: 8px;
    margin-top: 24px;
    font-size: 13px;
    color: var(--fg-subtle);
  }
  h1 {
    font-size: clamp(34px, 5vw, 52px);
    letter-spacing: -0.04em;
    line-height: 1.08;
  }
  .tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .author {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 64px;
    padding: 24px;
    flex-wrap: wrap;
  }
  .author p {
    font-size: 14px;
    margin-top: 2px;
  }
</style>
