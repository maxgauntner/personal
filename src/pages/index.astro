---
import Base from '../layouts/Base.astro';
import HeroConsole from '../components/HeroConsole.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleRow from '../components/ArticleRow.astro';
import { getArticles, getProjects } from '../utils';
import { SITE } from '../site';

const projects = (await getProjects()).filter((p) => p.data.featured);
const [lead, ...rest] = projects;
const articles = (await getArticles()).slice(0, 3);

// TODO: replace with your real numbers
const stats = [
  { value: '10+', label: 'Years designing B2B SaaS' },
  { value: '6', label: 'Security products shipped' },
  { value: '40k+', label: 'Analysts using my work daily' },
  { value: '3', label: 'Design systems built from zero' },
];

const domains = [
  'Threat detection',
  'XDR / SIEM',
  'Identity & access',
  'SOAR',
  'Vulnerability management',
  'Cloud security posture',
  'Compliance & GRC',
  'AI-assisted investigation',
];

const expertise = [
  {
    title: 'Data-dense interfaces',
    body: 'Tables, timelines and graphs that stay legible at 10,000 rows — built for analysts on their third monitor at 3am.',
    icon: 'M3 5h18M3 12h18M3 19h18M8 5v14',
  },
  {
    title: 'Explainable AI',
    body: 'Model outputs analysts can interrogate. Every score has a reason, every summary has a source.',
    icon: 'M12 3v3M12 18v3M3 12h3M18 12h3M6 6l2 2M16 16l2 2M6 18l2-2M16 8l2-2M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z',
  },
  {
    title: 'Workflow & automation',
    body: 'Playbooks, approvals and handoffs that remove toil without removing human judgment.',
    icon: 'M5 4h4v4H5zM15 16h4v4h-4zM7 8v4a4 4 0 0 0 4 4h4',
  },
  {
    title: 'Systems thinking',
    body: 'Design systems, tokens and patterns that let multiple product teams ship one coherent platform.',
    icon: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z',
  },
];

const process = [
  { n: '01', title: 'Sit with the SOC', body: 'Shadowing, tabletop exercises, timing real workflows. The truth is in the swivel-chair moments.' },
  { n: '02', title: 'Frame the decision', body: 'Every screen answers one question. I define it with PM and engineering before pixels.' },
  { n: '03', title: 'Prototype with real data', body: 'Messy, realistic data exposes edge cases early. Lorem ipsum hides them.' },
  { n: '04', title: 'Ship, measure, refine', body: 'Phased rollouts, instrumented outcomes, and a tight loop with customers.' },
];
---

<Base>
  <!-- ============================== HERO ============================== -->
  <section class="hero">
    <div class="bg-grid"></div>
    <div class="bg-glow glow-a"></div>
    <div class="bg-glow glow-b"></div>

    <div class="container hero-inner">
      <a href={`mailto:${SITE.email}`} class="chip hero-chip">
        <span class="status-dot"></span>
        Open to senior &amp; staff roles
        <span class="arrow">→</span>
      </a>

      <h1 class="display text-gradient">
        Designing clarity for<br class="br-lg" /> security teams under pressure.
      </h1>

      <p class="lead hero-lead">
        I'm {SITE.name.split(' ')[0]}, a Senior Product Designer who turns complex cybersecurity platforms into calm, decisive tools —
        threat detection, identity, and incident response products that analysts trust when it matters most.
      </p>

      <div class="hero-ctas">
        <a href="/projects" class="btn btn-primary">View case studies <span class="arrow">→</span></a>
        <a href="/about" class="btn btn-ghost">About me</a>
      </div>
    </div>

    <div class="container console-wrap">
      <HeroConsole />
    </div>
  </section>

  <!-- ============================== STATS + DOMAINS ============================== -->
  <section class="proof">
    <div class="container">
      <div class="stats reveal">
        {
          stats.map((s) => (
            <div class="stat">
              <span class="stat-value">{s.value}</span>
              <span class="stat-label">{s.label}</span>
            </div>
          ))
        }
      </div>
    </div>
    <div class="marquee" aria-label="Areas of expertise">
      <div class="track">
        {
          [...domains, ...domains].map((d, i) => (
            <span class="m-item" aria-hidden={i >= domains.length ? 'true' : undefined}>
              {d}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================== WORK ============================== -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">Selected work</span>
          <h2 class="h2">Complex problems, made legible.</h2>
          <p class="muted">Deep dives into products used by security teams to detect, investigate and respond to threats.</p>
        </div>
        <a href="/projects" class="link-arrow">All projects <span class="arrow">→</span></a>
      </div>

      <div class="work">
        {lead && <div class="reveal"><ProjectCard project={lead} large /></div>}
        <div class="work-grid">
          {rest.map((p) => <div class="reveal"><ProjectCard project={p} /></div>)}
        </div>
      </div>
    </div>
  </section>

  <!-- ============================== EXPERTISE ============================== -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">Focus</span>
          <h2 class="h2">Where I do my best work.</h2>
        </div>
      </div>
      <div class="bento">
        {
          expertise.map((e) => (
            <div class="bento-card glass reveal">
              <span class="b-icon">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d={e.icon} />
                </svg>
              </span>
              <h3>{e.title}</h3>
              <p class="muted">{e.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================== PROCESS ============================== -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div>
          <span class="eyebrow">Process</span>
          <h2 class="h2">How I approach high-stakes products.</h2>
        </div>
      </div>
      <ol class="process">
        {
          process.map((p) => (
            <li class="reveal">
              <span class="p-n mono">{p.n}</span>
              <h3>{p.title}</h3>
              <p class="muted">{p.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============================== WRITING ============================== -->
  {
    articles.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head reveal">
            <div>
              <span class="eyebrow">Writing</span>
              <h2 class="h2">Notes on security UX.</h2>
            </div>
            <a href="/articles" class="link-arrow">
              All articles <span class="arrow">→</span>
            </a>
          </div>
          <div class="reveal">
            {articles.map((a) => <ArticleRow article={a} />)}
          </div>
        </div>
      </section>
    )
  }

  <!-- ============================== CTA ============================== -->
  <section class="cta-section">
    <div class="container">
      <div class="cta glass reveal">
        <div class="bg-grid"></div>
        <div class="bg-glow cta-glow"></div>
        <span class="eyebrow">Let's talk</span>
        <h2 class="h2">Building something security teams<br class="br-lg" /> need to trust?</h2>
        <p class="lead">I'm always happy to talk about product, design systems, or the craft of making complex tools feel simple.</p>
        <div class="hero-ctas">
          <a href={`mailto:${SITE.email}`} class="btn btn-primary">Get in touch <span class="arrow">→</span></a>
          <a href="/about" class="btn btn-ghost">More about me</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding-top: clamp(72px, 12vw, 136px);
    margin-top: calc(-1 * (52px + 12px));
    padding-bottom: 32px;
    overflow: hidden;
  }
  .hero > .bg-grid {
    top: -64px;
  }
  .glow-a {
    width: 640px;
    height: 360px;
    left: 50%;
    top: 360px;
    transform: translateX(-50%);
  }
  .glow-b {
    width: 300px;
    height: 300px;
    right: -100px;
    top: 0;
    opacity: 0.5;
  }
  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 64px;
  }
  .hero-chip {
    height: 30px;
    padding-inline: 12px;
    font-size: 13px;
    margin-bottom: 28px;
    animation: rise 0.9s var(--ease) both;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .hero-chip:hover {
    color: var(--fg);
    border-color: var(--border-strong);
  }
  .hero-chip .arrow {
    color: var(--fg-subtle);
  }
  .display {
    max-width: 960px;
    animation: rise 0.9s var(--ease) 0.08s both;
  }
  .hero-lead {
    max-width: 640px;
    margin-top: 24px;
    animation: rise 0.9s var(--ease) 0.16s both;
  }
  .hero-ctas {
    display: flex;
    gap: 10px;
    margin-top: 36px;
    flex-wrap: wrap;
    justify-content: center;
    animation: rise 0.9s var(--ease) 0.24s both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(16px);
      filter: blur(6px);
    }
  }
  .console-wrap {
    position: relative;
    margin-top: clamp(56px, 8vw, 88px);
  }
  @media (max-width: 760px) {
    .br-lg {
      display: none;
    }
  }

  /* Proof */
  .proof {
    padding-block: 48px 0;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .stat {
    display: grid;
    gap: 6px;
    padding: 28px 24px;
  }
  .stat + .stat {
    border-left: 1px solid var(--border);
  }
  .stat-value {
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .stat-label {
    font-size: 13px;
    color: var(--fg-subtle);
  }
  @media (max-width: 760px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .stat:nth-child(3) {
      border-left: 0;
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }
  .marquee {
    margin-top: 48px;
    padding-block: 20px;
    border-block: 1px solid var(--border);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
    animation: scroll 40s linear infinite;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  .m-item {
    display: inline-flex;
    align-items: center;
    gap: 40px;
    padding-right: 40px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg-subtle);
    white-space: nowrap;
  }
  .m-item::after {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--fg-faint);
  }
  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }

  /* Work */
  .work {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }
  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .work-grid > div {
    display: grid;
  }
  @media (max-width: 760px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Bento */
  .bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .bento-card {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 24px;
  }
  .b-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: 14px;
    border-radius: 10px;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .bento-card h3 {
    font-size: 17px;
    letter-spacing: -0.02em;
  }
  .bento-card p {
    font-size: 14.5px;
    line-height: 1.6;
  }
  @media (max-width: 960px) {
    .bento {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .bento {
      grid-template-columns: 1fr;
    }
  }

  /* Process */
  .process {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--border);
  }
  .process li {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 28px 24px 0 0;
    position: relative;
  }
  .process li::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 32px;
    height: 1px;
    background: var(--accent);
  }
  .p-n {
    font-size: 12px;
    color: var(--accent);
  }
  .process h3 {
    font-size: 17px;
  }
  .process p {
    font-size: 14.5px;
  }
  @media (max-width: 860px) {
    .process {
      grid-template-columns: 1fr 1fr;
      row-gap: 32px;
      border-top: 0;
    }
    .process li {
      border-top: 1px solid var(--border);
    }
  }
  @media (max-width: 520px) {
    .process {
      grid-template-columns: 1fr;
    }
  }

  /* CTA */
  .cta-section {
    padding-block: clamp(48px, 8vw, 96px) clamp(72px, 10vw, 128px);
  }
  .cta {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    padding: clamp(40px, 7vw, 88px) 24px;
    border-radius: 28px;
  }
  .cta > .bg-grid {
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 100%, #000 20%, transparent 100%);
    mask-image: radial-gradient(ellipse 60% 70% at 50% 100%, #000 20%, transparent 100%);
  }
  .cta-glow {
    width: 520px;
    height: 220px;
    left: 50%;
    bottom: -140px;
    transform: translateX(-50%);
  }
  .cta .lead {
    max-width: 520px;
  }
  .cta .hero-ctas {
    margin-top: 16px;
    animation: none;
  }
</style>
